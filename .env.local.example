# ---- Mailchimp Marketing API (server-side — do NOT prefix with NEXT_PUBLIC) ----
# API key: Mailchimp > Account & billing > Extras > API keys > Create a key.
MAILCHIMP_API_KEY=

# Audience ID: Mailchimp > Audience > Settings > "Audience name and campaign defaults" > Audience ID.
MAILCHIMP_AUDIENCE_ID=

# Server prefix: the part before ".admin.mailchimp.com" in your Mailchimp URL (e.g. us21),
# also the text after the dash in your API key.
MAILCHIMP_SERVER_PREFIX=us21

# "subscribed" adds them straight away. Use "pending" if your audience is double opt-in
# (Mailchimp then emails a confirmation link before they're added).
MAILCHIMP_STATUS_IF_NEW=subscribed

# Tags applied to every entrant (comma-separated). This is how you find them in
# Mailchimp (Audience > Contacts > filter by tag) and trigger workflows.
MAILCHIMP_TAGS=Samoa Giveaway 2026,Website Entry

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://kings-siva.vercel.app
